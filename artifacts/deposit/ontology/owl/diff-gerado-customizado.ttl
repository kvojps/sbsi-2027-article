@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix ontompo: <https://example.org/ontompo/rodada-2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .

gufo:Category a owl:Class ;
    rdfs:label "Category"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:EventType a owl:Class ;
    rdfs:label "EventType"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:Kind a owl:Class ;
    rdfs:label "Kind"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:MaterialRelationshipType a owl:Class ;
    rdfs:label "MaterialRelationshipType"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:Role a owl:Class ;
    rdfs:label "Role"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:RoleMixin a owl:Class ;
    rdfs:label "RoleMixin"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:SubKind a owl:Class ;
    rdfs:label "SubKind"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:VariableCollection a owl:Class ;
    rdfs:label "VariableCollection"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:isCollectionMemberOf a owl:ObjectProperty ;
    rdfs:label "isCollectionMemberOf"@en ;
    rdfs:domain gufo:Object ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> ;
    rdfs:range gufo:Collection .

gufo:isComponentOf a owl:ObjectProperty ;
    rdfs:label "isComponentOf"@en ;
    rdfs:domain gufo:Object ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> ;
    rdfs:range gufo:FunctionalComplex .

gufo:isDerivedFrom a owl:ObjectProperty ;
    rdfs:label "isDerivedFrom"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> ;
    rdfs:range gufo:EndurantType .

gufo:isEventProperPartOf a owl:ObjectProperty ;
    rdfs:label "isEventProperPartOf"@en ;
    rdfs:domain gufo:Event ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> ;
    rdfs:range gufo:Event .

gufo:mediates a owl:ObjectProperty ;
    rdfs:label "mediates"@en ;
    rdfs:domain gufo:Relator ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> ;
    rdfs:range gufo:Endurant .

gufo:participatedIn a owl:ObjectProperty ;
    rdfs:label "participatedIn"@en ;
    rdfs:domain gufo:Object ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> ;
    rdfs:range gufo:Event .

gufo:wasCreatedIn a owl:ObjectProperty ;
    rdfs:label "wasCreatedIn"@en ;
    rdfs:domain gufo:Endurant ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> ;
    rdfs:range gufo:Event .

ontompo:CreateOperation rdfs:comment "Operação CRUD que faz passar a existir um registro que não existia."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    skos:prefLabel "CRUD Create Operation"@en,
        "Operação de criação"@pt-BR .

ontompo:CrudRepository rdfs:comment "Papel do gerenciamento de dados quando ele expõe um repositório sobre o qual operações CRUD são executadas."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    skos:prefLabel "CRUD Repository"@en,
        "Repositório CRUD"@pt-BR .

ontompo:DeleteOperation rdfs:comment "Operação CRUD que faz deixar de existir um registro."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    skos:prefLabel "CRUD Delete Operation"@en,
        "Operação de exclusão"@pt-BR .

ontompo:PhysicalAgent rdfs:comment "Agente cuja existência é a de um objeto físico concreto — no domínio do observatório, o indivíduo humano."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    skos:prefLabel "Physical Agent"@en,
        "Agente físico"@pt-BR .

ontompo:ReadOperation rdfs:comment "Operação CRUD que consulta um registro sem alterá-lo."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    skos:prefLabel "CRUD Read Operation"@en,
        "Operação de leitura"@pt-BR .

ontompo:SocialAgent rdfs:comment "Agente cuja existência depende de uma construção social: organizações e grupos que agem como um só."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    skos:prefLabel "Social Agent"@en,
        "Agente social"@pt-BR .

ontompo:UpdateOperation rdfs:comment "Operação CRUD que altera o conteúdo de um registro que já existia."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    skos:prefLabel "CRUD Update Operation"@en,
        "Operação de atualização"@pt-BR .

gufo:Collection a owl:Class ;
    rdfs:label "Collection"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:EndurantType a owl:Class ;
    rdfs:label "EndurantType"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:FunctionalComplex a owl:Class ;
    rdfs:label "FunctionalComplex"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:Relator a owl:Class ;
    rdfs:label "Relator"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

ontompo:ComputationalSystem rdfs:comment "Sistema computacional, tomado como o tipo que fornece princípio de identidade aos sistemas que interagem com o observatório."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    skos:prefLabel "Computational System"@en,
        "Sistema computacional"@pt-BR .

ontompo:CrudView rdfs:comment "Papel da visão quando é por ela que uma operação CRUD sobre o repositório é disparada."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    skos:prefLabel "CRUD View"@en,
        "Visão CRUD"@pt-BR .

ontompo:Disseminator rdfs:comment "Papel do software quando divulga análises e reflexões sobre os dados dos projetos observados, segundo as diretrizes de acesso e segurança do observatório."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    skos:prefLabel "Disseminator"@en,
        "Disseminação"@pt-BR .

ontompo:ObservatoryUser rdfs:comment "Ator humano que desfruta das utilidades que um observatório de projetos proporciona."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    skos:prefLabel "Observatory User"@en,
        "Usuário do observatório"@pt-BR .

ontompo:Organization rdfs:comment "Instituição à qual uma parte interessada pertence, e que pode ela própria afetar ou ser afetada pelos projetos observados."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    skos:prefLabel "Organization"@en,
        "Organização"@pt-BR .

ontompo:Person rdfs:comment "Ser humano que participa de um observatório de projetos, em qualquer papel."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    skos:prefLabel "Person"@en,
        "Pessoa"@pt-BR .

ontompo:StakeHolder rdfs:comment "Indivíduo, grupo ou organização que pode afetar ou ser afetado por uma decisão, atividade ou resultado de um projeto observado."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    skos:prefLabel "Stakeholder"@en,
        "Parte interessada"@pt-BR .

ontompo:Storer rdfs:comment "Papel do gerenciamento de dados quando armazena os dados coletados sobre os projetos, mantendo a referência aos dados brutos de origem."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    skos:prefLabel "Storer"@en,
        "Armazenamento"@pt-BR .

ontompo:System rdfs:comment "Ator não-humano: sistema computacional externo ao ambiente do observatório que executa alguma ação ou fornece algum serviço a ele."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    skos:prefLabel "System"@en,
        "Sistema"@pt-BR .

ontompo:componentOf_DataManager_ProjectObservatory rdfs:comment "Declara DataManager como componente do complexo funcional ProjectObservatory."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    owl:inverseOf ontompo:hasComponent_ProjectObservatory_DataManager .

ontompo:componentOf_View_ProjectObservatory rdfs:comment "Declara View como componente do complexo funcional ProjectObservatory."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    owl:inverseOf ontompo:hasComponent_ProjectObservatory_View .

ontompo:created_Observation_Knowledge a owl:ObjectProperty ;
    rdfs:label "created_Observation_Knowledge"@en ;
    rdfs:comment "Devolve o que passou a existir no evento Observation, e é Knowledge."@pt-BR ;
    rdfs:domain ontompo:Observation ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Knowledge ;
    owl:inverseOf ontompo:creation_Knowledge_Observation .

ontompo:creation_Knowledge_Observation rdfs:comment "Declara que Knowledge passa a existir no evento Observation."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    owl:inverseOf ontompo:created_Observation_Knowledge .

ontompo:hasComponent_ProjectObservatory_DataManager a owl:ObjectProperty ;
    rdfs:label "hasComponent_ProjectObservatory_DataManager"@en ;
    rdfs:comment "Devolve os componentes de ProjectObservatory que são DataManager."@pt-BR ;
    rdfs:domain ontompo:ProjectObservatory ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:DataManager ;
    owl:inverseOf ontompo:componentOf_DataManager_ProjectObservatory .

