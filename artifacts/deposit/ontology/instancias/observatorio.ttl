obs:transformacao_dadosAbertos a ontompo:Transform ;
    rdfs:label "Transformação — dados abertos institucionais"@pt-BR ;
    rdfs:comment "Evento de tratamento e modelagem dos dados de dados abertos institucionais."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/instancia-observatorio> ;
    ontompo:participational_Transform_EtlProcess obs:processoEtl_dadosAbertos .

obs:forunsDeDiscussao a ontompo:Reporter ;
    rdfs:label "Fóruns de discussão"@pt-BR ;
    rdfs:comment "«Cadastrar e participar de fóruns de discussão» (Anais Estendidos do XVIII SBSI, 2022, seção 4.1)."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/instancia-observatorio> ;
    skos:prefLabel "Fóruns de discussão"@pt-BR ;
    ontompo:componentOf_View_ProjectObservatory obs:observatorio .

obs:noticiasEmRedesSociais a ontompo:Reporter ;
    rdfs:label "Publicação de notícias em redes sociais"@pt-BR ;
    rdfs:comment "«Postar notícias em redes sociais» (Anais Estendidos do XVIII SBSI, 2022, seção 4.1)."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/instancia-observatorio> ;
    skos:prefLabel "Publicação de notícias em redes sociais"@pt-BR ;
    ontompo:componentOf_View_ProjectObservatory obs:observatorio .

obs:observacao_1 a ontompo:Observation ;
    rdfs:label "Observação 1"@pt-BR ;
    gufo:hasEndPointInXSDDate "2023-04-10"^^xsd:date ;
    rdfs:comment "Evento em que um agente observa conteúdo divulgado pelo observatório e no qual passa a existir conhecimento sobre os projetos observados."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/instancia-observatorio> .

obs:observacao_2 a ontompo:Observation ;
    rdfs:label "Observação 2"@pt-BR ;
    gufo:hasEndPointInXSDDate "2023-09-15"^^xsd:date ;
    rdfs:comment "Evento em que um agente observa conteúdo divulgado pelo observatório e no qual passa a existir conhecimento sobre os projetos observados."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/instancia-observatorio> .

obs:processoEtl_cadastro a ontompo:EtlProcess ;
    rdfs:label "Processo de ETL — cadastro de projetos"@pt-BR ;
    rdfs:comment "Evento complexo que leva os dados de cadastro de projetos até o repositório do observatório; a extração, a transformação e a carga são partes próprias dele."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/instancia-observatorio> .

obs:processoEtl_dadosAbertos a ontompo:EtlProcess ;
    rdfs:label "Processo de ETL — dados abertos institucionais"@pt-BR ;
    rdfs:comment "Evento complexo que leva os dados de dados abertos institucionais até o repositório do observatório; a extração, a transformação e a carga são partes próprias dele."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/instancia-observatorio> .

obs:interacaoComProjetos a ontompo:Reporter ;
    rdfs:label "Interação dos usuários com os projetos"@pt-BR ;
    rdfs:comment "«Permitir que usuários interajam com os projetos a partir da inclusão de comentários, reações e relatos de erro» (Anais Estendidos do XVIII SBSI, 2022, seção 4.1)."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/instancia-observatorio> ;
    skos:prefLabel "Interação dos usuários com os projetos"@pt-BR ;
    ontompo:componentOf_View_ProjectObservatory obs:observatorio .

obs:grupoDoObservatorio a ontompo:ObservatoryGroup ;
    rdfs:label "Grupo do observatório (protótipo)"@pt-BR ;
    rdfs:comment "Coletivo reunido em torno do observatório: a equipe de gerenciamento e operação, os perfis de usuário da survey e o sistema externo citado; Anais Estendidos do XVIII SBSI (2022), seções 4.2 e 4.3."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/instancia-observatorio> ;
    skos:prefLabel "Grupo do observatório (protótipo)"@pt-BR .

obs:gerenciadorDeConteudo a ontompo:Collector,
        ontompo:DataManager,
        ontompo:Processor,
        ontompo:Storer ;
    rdfs:label "Gerenciamento de conteúdo do observatório"@pt-BR ;
    rdfs:comment "Sistema de gerenciamento de conteúdo (WordPress, sobre PHP e MySQL) por meio do qual o observatório organiza, gerencia e disponibiliza os dados dos projetos; Anais Estendidos do XVIII SBSI (2022), seção 4.2."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/instancia-observatorio> ;
    skos:prefLabel "Gerenciamento de conteúdo do observatório"@pt-BR ;
    ontompo:componentOf_DataManager_ProjectObservatory obs:observatorio ;
    ontompo:participation_Collector_Extract obs:extracao_cadastro,
        obs:extracao_dadosAbertos ;
    ontompo:participation_Collector_Transform obs:transformacao_cadastro,
        obs:transformacao_dadosAbertos ;
    ontompo:participation_Processor_Load obs:carga_cadastro,
        obs:carga_dadosAbertos ;
    ontompo:participation_Processor_Transform obs:transformacao_cadastro,
        obs:transformacao_dadosAbertos ;
    ontompo:participation_Storer_Load obs:carga_cadastro,
        obs:carga_dadosAbertos .

obs:observatorio a ontompo:ProjectObservatory ;
    rdfs:label "Observatório de projetos de pesquisa e extensão (protótipo)"@pt-BR ;
    rdfs:comment "Protótipo funcional de observatório de projetos de pesquisa e extensão de uma universidade pública brasileira, construído em WordPress (PHP e MySQL) e avaliado por uma survey; descrito nos Anais Estendidos do XVIII SBSI (2022), seções 4.1 e 4.2."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/instancia-observatorio> ;
    skos:prefLabel "Observatório de projetos de pesquisa e extensão (protótipo)"@pt-BR .

<https://example.org/ontompo/instancia-observatorio> a owl:Ontology ;
    dct:description "Dados de instância de um observatório de projetos de pesquisa e extensão de uma universidade pública brasileira, derivados do que a publicação nos Anais Estendidos do XVIII SBSI (2022) documenta, com a cadeia de ETL/proveniência, as partes interessadas e as observações que as sete questões de competência exercitam. O mapa trecho→instância e as premissas do que vai além da fonte estão em procedencia.md."@pt-BR ;
    dct:source <https://doi.org/10.5753/sbsi_estendido.2022.222995> ;
    rdfs:comment "Sem dct:creator: a revisão do artigo é duplamente anônima. A publicação-fonte é citada em terceira pessoa, pelo seu DOI, e nenhum rótulo, IRI ou comentário identifica autoria, instituição ou localidade."@pt-BR ;
    owl:imports <https://example.org/ontompo/rodada-2> .

