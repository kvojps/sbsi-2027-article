    rdfs:isDefinedBy <https://example.org/ontompo/instancia-observatorio> ;
    ontompo:participational_Extract_EtlProcess obs:processoEtl_dadosAbertos .

obs:parteInteressadaCoordenacaoDeProjeto a ontompo:StakeHolder ;
    rdfs:label "Coordenação de projeto observado"@pt-BR ;
    rdfs:comment "Coordenação de um projeto observado, que acompanha o que o observatório divulga sobre ele. O Apêndice A da conceituação define parte interessada como «indivíduo, grupo ou organização»."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/instancia-observatorio> ;
    skos:prefLabel "Coordenação de projeto observado"@pt-BR ;
