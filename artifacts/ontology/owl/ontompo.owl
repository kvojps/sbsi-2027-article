  <rdf:Description rdf:about="https://example.org/ontompo/rodada-2">
    <dct:description xml:lang="pt-BR">Formalização do MPO revisada por análise ontológica fundamentada na UFO. Gerada a partir do modelo OntoUML pela transformação gUFO oficial e customizada por acréscimo; o acréscimo está no arquivo diff-gerado-customizado.ttl.</dct:description>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dct:title xml:lang="pt-BR">OntoMPO — ontologia do Modelo para Observatórios de Projetos</dct:title>
    <vann:preferredNamespacePrefix>ontompo</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://example.org/ontompo/rodada-2#</vann:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="pt-BR">Sem dct:creator: enquanto a revisão do artigo for duplamente anônima, declarar autoria aqui a quebraria. O IRI de exemplo é provisório e é fixado no depósito.</rdfs:comment>
    <owl:imports rdf:resource="http://purl.org/nemo/gufo#"/>
    <owl:versionInfo>rodada-2, customizada</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontompo/rodada-2#Agent">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="pt-BR">Categoria não-sortal que reúne tudo o que porta intenções e age no contexto de um observatório de projetos, seja um agente físico ou um agente social.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/ontompo/rodada-2"/>
    <rdfs:label xml:lang="en">Agent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Object"/>
    <owl:equivalentClass rdf:nodeID="n1cf2c5de7dedb86b2ae5"/>
    <skos:prefLabel xml:lang="en">Agent</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">Agente</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontompo/rodada-2#Collector">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Role"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="pt-BR">Papel do gerenciamento de dados quando captura, de forma interna ou externa, os dados dos projetos observados.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/ontompo/rodada-2"/>
    <rdfs:label xml:lang="en">Collector</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontompo/rodada-2#DataManager"/>
    <rdfs:subClassOf rdf:nodeID="n7954e2951cd555dc88fb"/>
    <rdfs:subClassOf rdf:nodeID="ndb6f33496e9d259b94dc"/>
    <skos:prefLabel xml:lang="pt-BR">Coleta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collector</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontompo/rodada-2#ComputationalSystem">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Kind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="pt-BR">Sistema computacional, tomado como o tipo que fornece princípio de identidade aos sistemas que interagem com o observatório.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/ontompo/rodada-2"/>
    <rdfs:label xml:lang="en">ComputationalSystem</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#FunctionalComplex"/>
    <skos:prefLabel xml:lang="en">Computational System</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">Sistema computacional</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontompo/rodada-2#Connection">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Kind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="pt-BR">Vínculo pelo qual um hardware do observatório se liga a uma rede.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/ontompo/rodada-2"/>
    <rdfs:label xml:lang="en">Connection</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Relator"/>
    <rdfs:subClassOf rdf:nodeID="n38795c01e0236f5628f5"/>
    <rdfs:subClassOf rdf:nodeID="ne1b0df479675a2b84e3a"/>
    <skos:prefLabel xml:lang="pt-BR">Conexão</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Connection</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontompo/rodada-2#CreateOperation">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#EventType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="pt-BR">Operação CRUD que faz passar a existir um registro que não existia.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/ontompo/rodada-2"/>
    <rdfs:label xml:lang="en">CreateOperation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontompo/rodada-2#CrudOperation"/>
    <skos:prefLabel xml:lang="en">CRUD Create Operation</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">Operação de criação</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontompo/rodada-2#CrudOperation">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#EventType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="pt-BR">Evento de operação sobre um repositório de dados do observatório.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/ontompo/rodada-2"/>
    <rdfs:label xml:lang="en">CrudOperation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Event"/>
    <rdfs:subClassOf rdf:nodeID="n529fe4742fe87ba83aa9"/>
    <rdfs:subClassOf rdf:nodeID="nd92e76f73de4aa8f90fc"/>
    <owl:equivalentClass rdf:nodeID="nd405874b78b4b9f2780b"/>
    <skos:prefLabel xml:lang="en">CRUD Operation</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">Operação CRUD</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontompo/rodada-2#CrudRepository">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Role"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="pt-BR">Papel do gerenciamento de dados quando ele expõe um repositório sobre o qual operações CRUD são executadas.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/ontompo/rodada-2"/>
    <rdfs:label xml:lang="en">CrudRepository</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontompo/rodada-2#DataManager"/>
    <skos:prefLabel xml:lang="en">CRUD Repository</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">Repositório CRUD</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontompo/rodada-2#CrudView">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Role"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="pt-BR">Papel da visão quando é por ela que uma operação CRUD sobre o repositório é disparada.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/ontompo/rodada-2"/>
    <rdfs:label xml:lang="en">CrudView</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontompo/rodada-2#View"/>
    <skos:prefLabel xml:lang="en">CRUD View</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">Visão CRUD</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontompo/rodada-2#DataManager">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Role"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="pt-BR">Ferramentas de software necessárias para que o observatório organize, gerencie e processe os dados relacionados aos projetos observados.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/ontompo/rodada-2"/>
    <rdfs:label xml:lang="en">DataManager</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontompo/rodada-2#Software"/>
    <skos:prefLabel xml:lang="en">Data Manager</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">Gerenciamento de dados</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontompo/rodada-2#DataSource">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Kind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="pt-BR">Origem principal dos dados coletados: sistemas internos, partes interessadas externas, bases de dados abertas ou sensores.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/ontompo/rodada-2"/>
    <rdfs:label xml:lang="en">DataSource</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#FunctionalComplex"/>
    <rdfs:subClassOf rdf:nodeID="n0bf66eb7e739113c0675"/>
    <skos:prefLabel xml:lang="en">Data Source</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">Fonte de dados</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontompo/rodada-2#DeleteOperation">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#EventType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="pt-BR">Operação CRUD que faz deixar de existir um registro.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/ontompo/rodada-2"/>
    <rdfs:label xml:lang="en">DeleteOperation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontompo/rodada-2#CrudOperation"/>
    <skos:prefLabel xml:lang="en">CRUD Delete Operation</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">Operação de exclusão</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontompo/rodada-2#Disseminator">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Role"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="pt-BR">Papel do software quando divulga análises e reflexões sobre os dados dos projetos observados, segundo as diretrizes de acesso e segurança do observatório.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/ontompo/rodada-2"/>
    <rdfs:label xml:lang="en">Disseminator</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/ontompo/rodada-2#View"/>
    <skos:prefLabel xml:lang="en">Disseminator</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">Disseminação</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontompo/rodada-2#EtlProcess">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#EventType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="pt-BR">Evento complexo que leva os dados da fonte até o repositório do observatório, e do qual a extração, a transformação e a carga são partes próprias.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/ontompo/rodada-2"/>
    <rdfs:label xml:lang="en">EtlProcess</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Event"/>
    <rdfs:subClassOf rdf:nodeID="n03f8a207d92329d951ee"/>
    <rdfs:subClassOf rdf:nodeID="n09c6ff9738f2c8607080"/>
