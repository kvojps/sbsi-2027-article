    rdfs:comment "Liga o Hardware ao relator Connection que o medeia."@pt-BR ;
    rdfs:domain ontompo:Hardware ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Connection ;
    owl:inverseOf ontompo:mediation_Connection_Hardware .

ontompo:mediatedBy_Hardware_SoftwareExecution a owl:ObjectProperty ;
    rdfs:label "mediatedBy_Hardware_SoftwareExecution"@en ;
    rdfs:comment "Liga o Hardware ao relator SoftwareExecution que o medeia."@pt-BR ;
    rdfs:domain ontompo:Hardware ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:SoftwareExecution ;
    owl:inverseOf ontompo:mediation_SoftwareExecution_Hardware .

