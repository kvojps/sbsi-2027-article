    rdfs:label "hasParticipant_Extract_DataSource"@en ;
    rdfs:comment "Devolve os participantes do evento Extract que são DataSource."@pt-BR ;
    rdfs:domain ontompo:Extract ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:DataSource ;
    owl:inverseOf ontompo:participation_DataSource_Extract .

ontompo:hasParticipant_Load_Processor a owl:ObjectProperty ;
    rdfs:label "hasParticipant_Load_Processor"@en ;
    rdfs:comment "Devolve os participantes do evento Load que são Processor."@pt-BR ;
    rdfs:domain ontompo:Load ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Processor ;
    owl:inverseOf ontompo:participation_Processor_Load .

