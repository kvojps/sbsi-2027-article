    rdfs:label "hasEventPart_EtlProcess_Load"@en ;
    rdfs:comment "Devolve as partes próprias do evento EtlProcess que são Load."@pt-BR ;
    rdfs:domain ontompo:EtlProcess ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Load ;
    owl:inverseOf ontompo:participational_Load_EtlProcess .

ontompo:hasEventPart_EtlProcess_Transform a owl:ObjectProperty ;
    rdfs:label "hasEventPart_EtlProcess_Transform"@en ;
    rdfs:comment "Devolve as partes próprias do evento EtlProcess que são Transform."@pt-BR ;
    rdfs:domain ontompo:EtlProcess ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Transform ;
    owl:inverseOf ontompo:participational_Transform_EtlProcess .

ontompo:hasMember_ObservatoryGroup_ObservatoryUser a owl:ObjectProperty ;
    rdfs:label "hasMember_ObservatoryGroup_ObservatoryUser"@en ;
    rdfs:comment "Devolve os membros do coletivo ObservatoryGroup que são ObservatoryUser."@pt-BR ;
    rdfs:domain ontompo:ObservatoryGroup ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:ObservatoryUser ;
    owl:inverseOf ontompo:memberOf_ObservatoryUser_ObservatoryGroup .

ontompo:hasMember_ObservatoryGroup_StakeHolder a owl:ObjectProperty ;
    rdfs:label "hasMember_ObservatoryGroup_StakeHolder"@en ;
    rdfs:comment "Devolve os membros do coletivo ObservatoryGroup que são StakeHolder."@pt-BR ;
    rdfs:domain ontompo:ObservatoryGroup ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:StakeHolder ;
