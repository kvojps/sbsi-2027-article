@prefix dct: <http://purl.org/dc/terms/> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix ontompo: <https://example.org/ontompo/rodada-2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gufo:isDerivedFrom a owl:ObjectProperty ;
    rdfs:label "isDerivedFrom"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> ;
    rdfs:range gufo:EndurantType .

ontompo:CrudRepository a gufo:Role,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "CrudRepository"@en ;
    rdfs:comment "Papel do gerenciamento de dados quando ele expõe um repositório sobre o qual operações CRUD são executadas."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf ontompo:DataManager ;
    skos:prefLabel "CRUD Repository"@en,
        "Repositório CRUD"@pt-BR .

gufo:Collection a owl:Class ;
    rdfs:label "Collection"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:EndurantType a owl:Class ;
    rdfs:label "EndurantType"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:MaterialRelationshipType a owl:Class ;
    rdfs:label "MaterialRelationshipType"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:RoleMixin a owl:Class ;
    rdfs:label "RoleMixin"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:SubKind a owl:Class ;
    rdfs:label "SubKind"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:VariableCollection a owl:Class ;
    rdfs:label "VariableCollection"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:wasCreatedIn a owl:ObjectProperty ;
    rdfs:label "wasCreatedIn"@en ;
    rdfs:domain gufo:Endurant ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> ;
    rdfs:range gufo:Event .

ontompo:Organization a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Organization"@en ;
    rdfs:comment "Instituição à qual uma parte interessada pertence, e que pode ela própria afetar ou ser afetada pelos projetos observados."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf gufo:FunctionalComplex,
        ontompo:SocialAgent ;
    skos:prefLabel "Organization"@en,
        "Organização"@pt-BR .

ontompo:componentOf_DataManager_ProjectObservatory a owl:ObjectProperty ;
    rdfs:label "componentOf_DataManager_ProjectObservatory"@en ;
    rdfs:comment "Declara DataManager como componente do complexo funcional ProjectObservatory."@pt-BR ;
    rdfs:domain ontompo:DataManager ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:ProjectObservatory ;
    rdfs:subPropertyOf gufo:isComponentOf ;
    owl:inverseOf ontompo:hasComponent_ProjectObservatory_DataManager .

ontompo:componentOf_View_ProjectObservatory a owl:ObjectProperty ;
    rdfs:label "componentOf_View_ProjectObservatory"@en ;
    rdfs:comment "Declara View como componente do complexo funcional ProjectObservatory."@pt-BR ;
    rdfs:domain ontompo:View ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:ProjectObservatory ;
    rdfs:subPropertyOf gufo:isComponentOf ;
    owl:inverseOf ontompo:hasComponent_ProjectObservatory_View .

ontompo:created_Observation_Knowledge a owl:ObjectProperty ;
    rdfs:label "created_Observation_Knowledge"@en ;
    rdfs:comment "Devolve o que passou a existir no evento Observation, e é Knowledge."@pt-BR ;
    rdfs:domain ontompo:Observation ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Knowledge ;
    owl:inverseOf ontompo:creation_Knowledge_Observation .

ontompo:hasComponent_ProjectObservatory_DataManager a owl:ObjectProperty ;
    rdfs:label "hasComponent_ProjectObservatory_DataManager"@en ;
    rdfs:comment "Devolve os componentes de ProjectObservatory que são DataManager."@pt-BR ;
    rdfs:domain ontompo:ProjectObservatory ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:DataManager ;
    owl:inverseOf ontompo:componentOf_DataManager_ProjectObservatory .

ontompo:hasComponent_ProjectObservatory_View a owl:ObjectProperty ;
    rdfs:label "hasComponent_ProjectObservatory_View"@en ;
    rdfs:comment "Devolve os componentes de ProjectObservatory que são View."@pt-BR ;
    rdfs:domain ontompo:ProjectObservatory ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:View ;
    owl:inverseOf ontompo:componentOf_View_ProjectObservatory .

ontompo:hasEventPart_EtlProcess_Extract a owl:ObjectProperty ;
    rdfs:label "hasEventPart_EtlProcess_Extract"@en ;
    rdfs:comment "Devolve as partes próprias do evento EtlProcess que são Extract."@pt-BR ;
    rdfs:domain ontompo:EtlProcess ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Extract ;
    owl:inverseOf ontompo:participational_Extract_EtlProcess .

