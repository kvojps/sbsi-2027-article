    rdfs:range gufo:Event .

ontompo:CrudView a gufo:Role,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "CrudView"@en ;
    rdfs:comment "Papel da visão quando é por ela que uma operação CRUD sobre o repositório é disparada."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf ontompo:View ;
    skos:prefLabel "CRUD View"@en,
        "Visão CRUD"@pt-BR .

ontompo:Disseminator a gufo:Role,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Disseminator"@en ;
    rdfs:comment "Papel do software quando divulga análises e reflexões sobre os dados dos projetos observados, segundo as diretrizes de acesso e segurança do observatório."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf ontompo:View ;
    skos:prefLabel "Disseminator"@en,
        "Disseminação"@pt-BR .

ontompo:PhysicalAgent a gufo:Category,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "PhysicalAgent"@en ;
    rdfs:comment "Agente cuja existência é a de um objeto físico concreto — no domínio do observatório, o indivíduo humano."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf gufo:FunctionalComplex,
        ontompo:Agent ;
    skos:prefLabel "Physical Agent"@en,
        "Agente físico"@pt-BR .

ontompo:SocialAgent a gufo:Category,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "SocialAgent"@en ;
    rdfs:comment "Agente cuja existência depende de uma construção social: organizações e grupos que agem como um só."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf ontompo:Agent ;
    skos:prefLabel "Social Agent"@en,
        "Agente social"@pt-BR .

ontompo:Storer a gufo:Role,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Storer"@en ;
    rdfs:comment "Papel do gerenciamento de dados quando armazena os dados coletados sobre os projetos, mantendo a referência aos dados brutos de origem."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ontompo:participation_Storer_Load ;
            owl:someValuesFrom ontompo:Load ],
        ontompo:DataManager ;
    skos:prefLabel "Storer"@en,
        "Armazenamento"@pt-BR .

ontompo:creation_Knowledge_Observation a owl:ObjectProperty ;
    rdfs:label "creation_Knowledge_Observation"@en ;
    rdfs:comment "Declara que Knowledge passa a existir no evento Observation."@pt-BR ;
    rdfs:domain ontompo:Knowledge ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Observation ;
    rdfs:subPropertyOf gufo:wasCreatedIn ;
    owl:inverseOf ontompo:created_Observation_Knowledge .

ontompo:mediation_ServiceProvision_Service a owl:ObjectProperty ;
    rdfs:label "mediation_ServiceProvision_Service"@en ;
    rdfs:comment "Liga o relator ServiceProvision ao Service que ele medeia. Uma mediação da UFO é dependência existencial: não há ServiceProvision sem o Service."@pt-BR ;
    rdfs:domain ontompo:ServiceProvision ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Service ;
    rdfs:subPropertyOf gufo:mediates ;
    owl:inverseOf ontompo:mediatedBy_Service_ServiceProvision .

