ontompo:mediation_Connection_Hardware a owl:ObjectProperty ;
    rdfs:label "mediation_Connection_Hardware"@en ;
    rdfs:comment "Liga o relator Connection ao Hardware que ele medeia. Uma mediação da UFO é dependência existencial: não há Connection sem o Hardware."@pt-BR ;
    rdfs:domain ontompo:Connection ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Hardware ;
    rdfs:subPropertyOf gufo:mediates ;
