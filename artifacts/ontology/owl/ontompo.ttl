    rdfs:label "hasParticipant_Observation_Agent"@en ;
    rdfs:comment "Devolve os participantes do evento Observation que são Agent."@pt-BR ;
    rdfs:domain ontompo:Observation ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Agent ;
    owl:inverseOf ontompo:participation_Agent_Observation .

ontompo:hasParticipant_Observation_Disseminator a owl:ObjectProperty ;
