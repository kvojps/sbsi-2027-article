    rdfs:label "hasParticipant_Load_Storer"@en ;
    rdfs:comment "Devolve os participantes do evento Load que são Storer."@pt-BR ;
    rdfs:domain ontompo:Load ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
