    rdfs:label "mediatedBy_DataManager_ViewProvision"@en ;
    rdfs:comment "Liga o DataManager ao relator ViewProvision que o medeia."@pt-BR ;
    rdfs:domain ontompo:DataManager ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:ViewProvision ;
    owl:inverseOf ontompo:mediation_ViewProvision_DataManager .

