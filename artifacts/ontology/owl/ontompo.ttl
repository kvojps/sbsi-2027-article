    rdfs:label "mediatedBy_View_ViewProvision"@en ;
    rdfs:comment "Liga o View ao relator ViewProvision que o medeia."@pt-BR ;
    rdfs:domain ontompo:View ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:ViewProvision ;
    owl:inverseOf ontompo:mediation_ViewProvision_View .

ontompo:memberOf_ObservatoryUser_ObservatoryGroup a owl:ObjectProperty ;
    rdfs:label "memberOf_ObservatoryUser_ObservatoryGroup"@en ;
    rdfs:comment "Declara ObservatoryUser como membro do coletivo ObservatoryGroup."@pt-BR ;
    rdfs:domain ontompo:ObservatoryUser ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:ObservatoryGroup ;
    rdfs:subPropertyOf gufo:isCollectionMemberOf ;
    owl:inverseOf ontompo:hasMember_ObservatoryGroup_ObservatoryUser .

ontompo:memberOf_StakeHolder_ObservatoryGroup a owl:ObjectProperty ;
    rdfs:label "memberOf_StakeHolder_ObservatoryGroup"@en ;
    rdfs:comment "Declara StakeHolder como membro do coletivo ObservatoryGroup."@pt-BR ;
    rdfs:domain ontompo:StakeHolder ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:ObservatoryGroup ;
    rdfs:subPropertyOf gufo:isCollectionMemberOf ;
    owl:inverseOf ontompo:hasMember_ObservatoryGroup_StakeHolder .

