    rdfs:comment "Devolve os participantes do evento Transform que são Collector."@pt-BR ;
    rdfs:domain ontompo:Transform ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Collector ;
    owl:inverseOf ontompo:participation_Collector_Transform .

ontompo:hasParticipant_Transform_Processor a owl:ObjectProperty ;
    rdfs:label "hasParticipant_Transform_Processor"@en ;
    rdfs:comment "Devolve os participantes do evento Transform que são Processor."@pt-BR ;
    rdfs:domain ontompo:Transform ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Processor ;
    owl:inverseOf ontompo:participation_Processor_Transform .

ontompo:inverseMaterial_Hardware_Software a owl:ObjectProperty ;
    rdfs:label "inverseMaterial_Hardware_Software"@en ;
    rdfs:comment "Relação material entre Hardware e Software, no sentido inverso ao gerado."@pt-BR ;
    rdfs:domain ontompo:Hardware ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Software ;
    owl:inverseOf ontompo:material_Software_Hardware .

ontompo:material_Software_Hardware a gufo:MaterialRelationshipType,
        owl:ObjectProperty ;
    rdfs:label "material_Software_Hardware"@en ;
    gufo:isDerivedFrom ontompo:SoftwareExecution ;
    rdfs:comment "Relação material entre Software e Hardware, derivada do relator que a fundamenta."@pt-BR ;
    rdfs:domain ontompo:Software ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Hardware ;
    owl:inverseOf ontompo:inverseMaterial_Hardware_Software .

ontompo:mediatedBy_Agent_Log a owl:ObjectProperty ;
    rdfs:label "mediatedBy_Agent_Log"@en ;
    rdfs:comment "Liga o Agent ao relator Log que o medeia."@pt-BR ;
    rdfs:domain ontompo:Agent ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Log ;
    owl:inverseOf ontompo:mediation_Log_Agent .

ontompo:mediatedBy_Agent_SocialInteraction a owl:ObjectProperty ;
    rdfs:label "mediatedBy_Agent_SocialInteraction"@en ;
    rdfs:comment "Liga o Agent ao relator SocialInteraction que o medeia."@pt-BR ;
    rdfs:domain ontompo:Agent ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:SocialInteraction ;
    owl:inverseOf ontompo:mediation_SocialInteraction_Agent .

