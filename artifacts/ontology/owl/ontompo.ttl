    rdfs:label "mediatedBy_Software_SoftwareExecution"@en ;
    rdfs:comment "Liga o Software ao relator SoftwareExecution que o medeia."@pt-BR ;
    rdfs:domain ontompo:Software ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:SoftwareExecution ;
    owl:inverseOf ontompo:mediation_SoftwareExecution_Software .

