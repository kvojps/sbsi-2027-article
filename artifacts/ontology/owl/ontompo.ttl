    rdfs:label "mediation_SoftwareExecution_Software"@en ;
    rdfs:comment "Liga o relator SoftwareExecution ao Software que ele medeia. Uma mediação da UFO é dependência existencial: não há SoftwareExecution sem o Software."@pt-BR ;
    rdfs:domain ontompo:SoftwareExecution ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Software ;
    rdfs:subPropertyOf gufo:mediates ;
    owl:inverseOf ontompo:mediatedBy_Software_SoftwareExecution .

ontompo:participation_Collector_Extract a owl:ObjectProperty ;
    rdfs:label "participation_Collector_Extract"@en ;
    rdfs:comment "Registra a participação de Collector no evento Extract."@pt-BR ;
    rdfs:domain ontompo:Collector ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Extract ;
    rdfs:subPropertyOf gufo:participatedIn ;
    owl:inverseOf ontompo:hasParticipant_Extract_Collector .

ontompo:participation_Collector_Transform a owl:ObjectProperty ;
    rdfs:label "participation_Collector_Transform"@en ;
    rdfs:comment "Registra a participação de Collector no evento Transform."@pt-BR ;
    rdfs:domain ontompo:Collector ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Transform ;
    rdfs:subPropertyOf gufo:participatedIn ;
    owl:inverseOf ontompo:hasParticipant_Transform_Collector .

ontompo:participation_DataSource_Extract a owl:ObjectProperty ;
    rdfs:label "participation_DataSource_Extract"@en ;
    rdfs:comment "Registra a participação de DataSource no evento Extract."@pt-BR ;
    rdfs:domain ontompo:DataSource ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Extract ;
    rdfs:subPropertyOf gufo:participatedIn ;
    owl:inverseOf ontompo:hasParticipant_Extract_DataSource .

ontompo:participation_Processor_Load a owl:ObjectProperty ;
    rdfs:label "participation_Processor_Load"@en ;
    rdfs:comment "Registra a participação de Processor no evento Load."@pt-BR ;
    rdfs:domain ontompo:Processor ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Load ;
    rdfs:subPropertyOf gufo:participatedIn ;
    owl:inverseOf ontompo:hasParticipant_Load_Processor .

ontompo:participation_Processor_Transform a owl:ObjectProperty ;
    rdfs:label "participation_Processor_Transform"@en ;
    rdfs:comment "Registra a participação de Processor no evento Transform."@pt-BR ;
    rdfs:domain ontompo:Processor ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Transform ;
    rdfs:subPropertyOf gufo:participatedIn ;
    owl:inverseOf ontompo:hasParticipant_Transform_Processor .

ontompo:participation_Storer_Load a owl:ObjectProperty ;
    rdfs:label "participation_Storer_Load"@en ;
    rdfs:comment "Registra a participação de Storer no evento Load."@pt-BR ;
    rdfs:domain ontompo:Storer ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Load ;
    rdfs:subPropertyOf gufo:participatedIn ;
    owl:inverseOf ontompo:hasParticipant_Load_Storer .

ontompo:participational_Extract_EtlProcess a owl:ObjectProperty ;
    rdfs:label "participational_Extract_EtlProcess"@en ;
    rdfs:comment "Declara o evento Extract como parte própria do evento EtlProcess."@pt-BR ;
    rdfs:domain ontompo:Extract ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:EtlProcess ;
    rdfs:subPropertyOf gufo:isEventProperPartOf ;
    owl:inverseOf ontompo:hasEventPart_EtlProcess_Extract .

ontompo:participational_Load_EtlProcess a owl:ObjectProperty ;
    rdfs:label "participational_Load_EtlProcess"@en ;
    rdfs:comment "Declara o evento Load como parte própria do evento EtlProcess."@pt-BR ;
    rdfs:domain ontompo:Load ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:EtlProcess ;
    rdfs:subPropertyOf gufo:isEventProperPartOf ;
    owl:inverseOf ontompo:hasEventPart_EtlProcess_Load .

ontompo:participational_Transform_EtlProcess a owl:ObjectProperty ;
    rdfs:label "participational_Transform_EtlProcess"@en ;
    rdfs:comment "Declara o evento Transform como parte própria do evento EtlProcess."@pt-BR ;
    rdfs:domain ontompo:Transform ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:EtlProcess ;
    rdfs:subPropertyOf gufo:isEventProperPartOf ;
    owl:inverseOf ontompo:hasEventPart_EtlProcess_Transform .

gufo:Object a owl:Class ;
    rdfs:label "Object"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

ontompo:DataSource a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "DataSource"@en ;
    rdfs:comment "Origem principal dos dados coletados: sistemas internos, partes interessadas externas, bases de dados abertas ou sensores."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ontompo:participation_DataSource_Extract ;
            owl:someValuesFrom ontompo:Extract ],
        gufo:FunctionalComplex ;
    skos:prefLabel "Data Source"@en,
        "Fonte de dados"@pt-BR .

ontompo:Knowledge a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Knowledge"@en ;
    rdfs:comment "Conhecimento sobre os projetos observados, adquirido e construído a partir do conteúdo que o observatório disponibiliza."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ontompo:Observation ;
            owl:onProperty ontompo:creation_Knowledge_Observation ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:FunctionalComplex ;
    skos:prefLabel "Knowledge"@en,
        "Conhecimento"@pt-BR .

ontompo:Network a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Network"@en ;
    rdfs:comment "Componentes que possibilitam a comunicação, o gerenciamento e as operações de rede entre um observatório de projetos e os sistemas internos e externos das organizações."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    skos:prefLabel "Network"@en,
        "Rede"@pt-BR .

ontompo:Project a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Project"@en ;
    rdfs:comment "Projeto observado: aquele sobre o qual o observatório reúne e divulga dados, informação e conhecimento, e que ele não gerencia."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    skos:prefLabel "Project"@en,
        "Projeto"@pt-BR .

ontompo:Service a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Service"@en ;
    rdfs:comment "Serviços executados por terceiros para estruturar, operar e manter a infraestrutura de TI de um observatório de projetos."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ontompo:mediation_ServiceProvision_Service ] ;
            owl:someValuesFrom ontompo:ServiceProvision ],
        gufo:FunctionalComplex ;
    skos:prefLabel "Service"@en,
        "Serviço"@pt-BR .

ontompo:Connection a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Connection"@en ;
    rdfs:comment "Vínculo pelo qual um hardware do observatório se liga a uma rede."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Hardware ;
            owl:onProperty ontompo:mediation_Connection_Hardware ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Network ;
            owl:onProperty ontompo:mediation_Connection_Network ],
        gufo:Relator ;
    skos:prefLabel "Connection"@en,
        "Conexão"@pt-BR .

ontompo:Log a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Log"@en ;
    rdfs:comment "Registro que responsabiliza um agente por suas ações no contexto do observatório, e que sustenta a auditoria dessas ações."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Reporter ;
            owl:onProperty ontompo:mediation_Log_Reporter ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Agent ;
            owl:onProperty ontompo:mediation_Log_Agent ],
        gufo:Relator ;
    skos:prefLabel "Log"@en,
        "Registro de auditoria"@pt-BR .

ontompo:ProjectDataManagement a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ProjectDataManagement"@en ;
    rdfs:comment "Vínculo pelo qual um gerenciamento de dados responde pelos dados de um projeto observado."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:DataManager ;
            owl:onProperty ontompo:mediation_ProjectDataManagement_DataManager ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Project ;
            owl:onProperty ontompo:mediation_ProjectDataManagement_Project ],
        gufo:Relator ;
    skos:prefLabel "Project Data Management"@en,
        "Gerência de dados de projeto"@pt-BR .

ontompo:ProjectObservatory a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ProjectObservatory"@en ;
    rdfs:comment "Observatório de projetos: o software que coleta, integra e divulga informação sobre um conjunto de projetos observados, para dar transparência e prestação de contas a partes interessadas externas."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf ontompo:Software ;
    skos:prefLabel "Project Observatory"@en,
        "Observatório de projetos"@pt-BR .

ontompo:SocialInteraction a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "SocialInteraction"@en ;
    rdfs:comment "Vínculo de interação entre os agentes de um observatório de projetos e entre eles e o conteúdo dele."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Reporter ;
            owl:onProperty ontompo:mediation_SocialInteraction_Reporter ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Agent ;
            owl:onProperty ontompo:mediation_SocialInteraction_Agent ],
        gufo:Relator ;
    skos:prefLabel "Social Interaction"@en,
        "Interação social"@pt-BR .

ontompo:ViewProvision a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ViewProvision"@en ;
    rdfs:comment "Vínculo pelo qual um gerenciamento de dados disponibiliza uma visão."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:DataManager ;
            owl:onProperty ontompo:mediation_ViewProvision_DataManager ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:View ;
            owl:onProperty ontompo:mediation_ViewProvision_View ],
        gufo:Relator ;
    skos:prefLabel "View Provision"@en,
        "Disponibilização de visão"@pt-BR .

ontompo:Collector a gufo:Role,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Collector"@en ;
    rdfs:comment "Papel do gerenciamento de dados quando captura, de forma interna ou externa, os dados dos projetos observados."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ontompo:participation_Collector_Extract ;
            owl:someValuesFrom ontompo:Extract ],
        [ a owl:Restriction ;
            owl:onProperty ontompo:participation_Collector_Transform ;
            owl:someValuesFrom ontompo:Transform ],
        ontompo:DataManager ;
    skos:prefLabel "Collector"@en,
        "Coleta"@pt-BR .

ontompo:Processor a gufo:Role,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Processor"@en ;
    rdfs:comment "Papel do gerenciamento de dados quando trata e converte os dados brutos dos projetos em uma forma mais significativa."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ontompo:participation_Processor_Load ;
            owl:someValuesFrom ontompo:Load ],
        [ a owl:Restriction ;
            owl:onProperty ontompo:participation_Processor_Transform ;
            owl:someValuesFrom ontompo:Transform ],
        ontompo:DataManager ;
    skos:prefLabel "Processor"@en,
        "Processamento"@pt-BR .

ontompo:Reporter a gufo:Role,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Reporter"@en ;
    rdfs:comment "Papel do software quando coordena os relacionamentos entre os usuários, a interação deles com os projetos e com o observatório, e o relacionamento do observatório com outros sistemas."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf ontompo:View ;
    skos:prefLabel "Reporter"@en,
        "Relacionamento"@pt-BR .

ontompo:ServiceProvision a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ServiceProvision"@en ;
    rdfs:comment "Vínculo pelo qual um serviço é prestado a um software do observatório de projetos."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Software ;
            owl:onProperty ontompo:mediation_ServiceProvision_Software ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Service ;
            owl:onProperty ontompo:mediation_ServiceProvision_Service ],
        gufo:Relator ;
    skos:prefLabel "Service Provision"@en,
        "Prestação de serviço"@pt-BR .

ontompo:Observation a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Observation"@en ;
    rdfs:comment "Evento em que um agente observa o conteúdo divulgado pelo observatório e no qual passa a existir conhecimento sobre os projetos observados."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Agent ;
            owl:onProperty [ owl:inverseOf ontompo:participation_Agent_Observation ] ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Disseminator ;
            owl:onProperty [ owl:inverseOf ontompo:participation_Disseminator_Observation ] ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ontompo:creation_Knowledge_Observation ] ;
            owl:someValuesFrom ontompo:Knowledge ],
        gufo:Event ;
    skos:prefLabel "Observation"@en,
        "Observação"@pt-BR .

ontompo:ObservatoryGroup a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ObservatoryGroup"@en ;
    rdfs:comment "Coletivo de agentes reunidos em torno de um observatório de projetos: a equipe responsável pelo gerenciamento, manutenção e operação do observatório, seus usuários e os sistemas que com ele trocam."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf gufo:VariableCollection ;
    skos:prefLabel "Observatory Group"@en,
        "Grupo do observatório"@pt-BR .

ontompo:SoftwareExecution a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "SoftwareExecution"@en ;
    rdfs:comment "Vínculo pelo qual um software é executado sobre um hardware. Substitui a composição inválida entre os dois, corrigida em A2."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Software ;
            owl:onProperty ontompo:mediation_SoftwareExecution_Software ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Hardware ;
            owl:onProperty ontompo:mediation_SoftwareExecution_Hardware ],
        gufo:Relator ;
    skos:prefLabel "Software Execution"@en,
        "Execução de software"@pt-BR .

gufo:Relator a owl:Class ;
    rdfs:label "Relator"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

ontompo:CrudOperation a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "CrudOperation"@en ;
    rdfs:comment "Evento de operação sobre um repositório de dados do observatório."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Agent ;
            owl:onProperty [ owl:inverseOf ontompo:participation_Agent_CrudOperation ] ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:CrudView ;
            owl:onProperty [ owl:inverseOf ontompo:participation_CrudView_CrudOperation ] ],
        gufo:Event ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ontompo:CreateOperation ontompo:ReadOperation ontompo:UpdateOperation ontompo:DeleteOperation ) ] ;
    skos:prefLabel "CRUD Operation"@en,
        "Operação CRUD"@pt-BR .

ontompo:EtlProcess a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "EtlProcess"@en ;
    rdfs:comment "Evento complexo que leva os dados da fonte até o repositório do observatório, e do qual a extração, a transformação e a carga são partes próprias."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ontompo:Transform ;
            owl:onProperty [ owl:inverseOf ontompo:participational_Transform_EtlProcess ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ontompo:Load ;
            owl:onProperty [ owl:inverseOf ontompo:participational_Load_EtlProcess ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ontompo:Extract ;
            owl:onProperty [ owl:inverseOf ontompo:participational_Extract_EtlProcess ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:Event ;
    skos:prefLabel "ETL Process"@en,
        "Processo de ETL"@pt-BR .

ontompo:Extract a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Extract"@en ;
    rdfs:comment "Evento de identificação e coleta dos dados e informações relevantes sobre os projetos observados e suas temáticas."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:DataSource ;
            owl:onProperty [ owl:inverseOf ontompo:participation_DataSource_Extract ] ],
        [ a owl:Restriction ;
            owl:onClass ontompo:EtlProcess ;
            owl:onProperty ontompo:participational_Extract_EtlProcess ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Collector ;
            owl:onProperty [ owl:inverseOf ontompo:participation_Collector_Extract ] ],
        gufo:Event ;
    skos:prefLabel "Extract"@en,
        "Extração"@pt-BR .

ontompo:Hardware a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Hardware"@en ;
    rdfs:comment "Equipamento físico de tecnologia da informação utilizado nos processos executados pelos observatórios de projetos."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    skos:prefLabel "Hardware"@en,
        "Hardware"@pt-BR .

ontompo:Load a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Load"@en ;
    rdfs:comment "Evento de armazenamento, em um repositório, dos dados coletados e transformados sobre os projetos observados."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ontompo:EtlProcess ;
            owl:onProperty ontompo:participational_Load_EtlProcess ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Storer ;
            owl:onProperty [ owl:inverseOf ontompo:participation_Storer_Load ] ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Processor ;
            owl:onProperty [ owl:inverseOf ontompo:participation_Processor_Load ] ],
        gufo:Event ;
    skos:prefLabel "Load"@en,
        "Carga"@pt-BR .

ontompo:Transform a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Transform"@en ;
    rdfs:comment "Evento de transformação e modelagem dos dados coletados pelo observatório de projetos."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Processor ;
            owl:onProperty [ owl:inverseOf ontompo:participation_Processor_Transform ] ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ontompo:Collector ;
            owl:onProperty [ owl:inverseOf ontompo:participation_Collector_Transform ] ],
        [ a owl:Restriction ;
            owl:onClass ontompo:EtlProcess ;
            owl:onProperty ontompo:participational_Transform_EtlProcess ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:Event ;
    skos:prefLabel "Transform"@en,
        "Transformação"@pt-BR .

ontompo:View a gufo:Role,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "View"@en ;
    rdfs:comment "Papel do software quando apresenta ao usuário o conteúdo do observatório de projetos."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf ontompo:Software ;
    skos:prefLabel "View"@en,
        "Visão"@pt-BR .

gufo:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:EventType a owl:Class ;
    rdfs:label "EventType"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:participatedIn a owl:ObjectProperty ;
    rdfs:label "participatedIn"@en ;
    rdfs:domain gufo:Object ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> ;
    rdfs:range gufo:Event .

gufo:FunctionalComplex a owl:Class ;
    rdfs:label "FunctionalComplex"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:Role a owl:Class ;
    rdfs:label "Role"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

ontompo:Software a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Software"@en ;
    rdfs:comment "Aplicações que possibilitam a execução dos processos executados pelos observatórios de projetos."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ontompo:mediation_SoftwareExecution_Software ] ;
            owl:someValuesFrom ontompo:SoftwareExecution ],
        gufo:FunctionalComplex ;
    skos:prefLabel "Software"@en,
        "Software"@pt-BR .

ontompo:DataManager a gufo:Role,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "DataManager"@en ;
    rdfs:comment "Ferramentas de software necessárias para que o observatório organize, gerencie e processe os dados relacionados aos projetos observados."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf ontompo:Software ;
    skos:prefLabel "Data Manager"@en,
        "Gerenciamento de dados"@pt-BR .

gufo:mediates a owl:ObjectProperty ;
    rdfs:label "mediates"@en ;
    rdfs:domain gufo:Relator ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> ;
    rdfs:range gufo:Endurant .

ontompo:Agent a gufo:Category,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Agent"@en ;
    rdfs:comment "Categoria não-sortal que reúne tudo o que porta intenções e age no contexto de um observatório de projetos, seja um agente físico ou um agente social."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf gufo:Object ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ontompo:PhysicalAgent ontompo:SocialAgent ) ] ;
    skos:prefLabel "Agent"@en,
        "Agente"@pt-BR .

gufo:Kind a owl:Class ;
    rdfs:label "Kind"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

<https://example.org/ontompo/rodada-2> a owl:Ontology ;
    dct:description "Formalização do MPO revisada por análise ontológica fundamentada na UFO. Gerada a partir do modelo OntoUML pela transformação gUFO oficial e customizada por acréscimo; o acréscimo está no arquivo diff-gerado-customizado.ttl."@pt-BR ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:title "OntoMPO — ontologia do Modelo para Observatórios de Projetos"@pt-BR ;
    vann:preferredNamespacePrefix "ontompo" ;
    vann:preferredNamespaceUri "https://example.org/ontompo/rodada-2#" ;
    rdfs:comment "Sem dct:creator: enquanto a revisão do artigo for duplamente anônima, declarar autoria aqui a quebraria. O IRI de exemplo é provisório e é fixado no depósito."@pt-BR ;
    owl:imports gufo: ;
    owl:versionInfo "rodada-2, customizada" .

[] a owl:AllDisjointClasses ;
    owl:members ( ontompo:ComputationalSystem ontompo:Connection ontompo:DataSource ontompo:Hardware ontompo:Knowledge ontompo:Log ontompo:Network ontompo:ObservatoryGroup ontompo:Organization ontompo:Person ontompo:Project ontompo:ProjectDataManagement ontompo:Service ontompo:ServiceProvision ontompo:SocialInteraction ontompo:Software ontompo:SoftwareExecution ontompo:ViewProvision ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ontompo:PhysicalAgent ontompo:SocialAgent ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ontompo:CreateOperation ontompo:ReadOperation ontompo:UpdateOperation ontompo:DeleteOperation ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ontompo:DataManager ontompo:View ontompo:ProjectObservatory ) .

