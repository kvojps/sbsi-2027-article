    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Connection ;
    owl:inverseOf ontompo:mediation_Connection_Network .

ontompo:mediatedBy_Project_ProjectDataManagement a owl:ObjectProperty ;
    rdfs:label "mediatedBy_Project_ProjectDataManagement"@en ;
    rdfs:comment "Liga o Project ao relator ProjectDataManagement que o medeia."@pt-BR ;
    rdfs:domain ontompo:Project ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:ProjectDataManagement ;
    owl:inverseOf ontompo:mediation_ProjectDataManagement_Project .

ontompo:mediatedBy_Reporter_Log a owl:ObjectProperty ;
    rdfs:label "mediatedBy_Reporter_Log"@en ;
    rdfs:comment "Liga o Reporter ao relator Log que o medeia."@pt-BR ;
    rdfs:domain ontompo:Reporter ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Log ;
    owl:inverseOf ontompo:mediation_Log_Reporter .

ontompo:mediatedBy_Reporter_SocialInteraction a owl:ObjectProperty ;
    rdfs:label "mediatedBy_Reporter_SocialInteraction"@en ;
    rdfs:comment "Liga o Reporter ao relator SocialInteraction que o medeia."@pt-BR ;
    rdfs:domain ontompo:Reporter ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:SocialInteraction ;
