    rdfs:domain ontompo:Software ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:ServiceProvision ;
    owl:inverseOf ontompo:mediation_ServiceProvision_Software .

