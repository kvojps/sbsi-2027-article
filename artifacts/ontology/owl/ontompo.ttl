ontompo:hasMember_ObservatoryGroup_System a owl:ObjectProperty ;
    rdfs:label "hasMember_ObservatoryGroup_System"@en ;
    rdfs:comment "Devolve os membros do coletivo ObservatoryGroup que são System."@pt-BR ;
    rdfs:domain ontompo:ObservatoryGroup ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:System ;
    owl:inverseOf ontompo:memberOf_System_ObservatoryGroup .

ontompo:hasParticipant_CrudOperation_Agent a owl:ObjectProperty ;
    rdfs:label "hasParticipant_CrudOperation_Agent"@en ;
    rdfs:comment "Devolve os participantes do evento CrudOperation que são Agent."@pt-BR ;
    rdfs:domain ontompo:CrudOperation ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:Agent ;
    owl:inverseOf ontompo:participation_Agent_CrudOperation .

ontompo:hasParticipant_CrudOperation_CrudView a owl:ObjectProperty ;
    rdfs:label "hasParticipant_CrudOperation_CrudView"@en ;
    rdfs:comment "Devolve os participantes do evento CrudOperation que são CrudView."@pt-BR ;
    rdfs:domain ontompo:CrudOperation ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:CrudView ;
    owl:inverseOf ontompo:participation_CrudView_CrudOperation .

ontompo:hasParticipant_Extract_Collector a owl:ObjectProperty ;
    rdfs:label "hasParticipant_Extract_Collector"@en ;
    rdfs:comment "Devolve os participantes do evento Extract que são Collector."@pt-BR ;
    rdfs:domain ontompo:Extract ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
