    rdfs:label "memberOf_System_ObservatoryGroup"@en ;
    rdfs:comment "Declara System como membro do coletivo ObservatoryGroup."@pt-BR ;
    rdfs:domain ontompo:System ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:range ontompo:ObservatoryGroup ;
    rdfs:subPropertyOf gufo:isCollectionMemberOf ;
    owl:inverseOf ontompo:hasMember_ObservatoryGroup_System .

gufo:Endurant a owl:Class ;
    rdfs:label "Endurant"@en ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> .

gufo:isComponentOf a owl:ObjectProperty ;
    rdfs:label "isComponentOf"@en ;
    rdfs:domain gufo:Object ;
    rdfs:isDefinedBy <http://purl.org/nemo/gufo> ;
    rdfs:range gufo:FunctionalComplex .

ontompo:ComputationalSystem a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ComputationalSystem"@en ;
    rdfs:comment "Sistema computacional, tomado como o tipo que fornece princípio de identidade aos sistemas que interagem com o observatório."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    skos:prefLabel "Computational System"@en,
        "Sistema computacional"@pt-BR .

ontompo:CreateOperation a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "CreateOperation"@en ;
    rdfs:comment "Operação CRUD que faz passar a existir um registro que não existia."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf ontompo:CrudOperation ;
    skos:prefLabel "CRUD Create Operation"@en,
        "Operação de criação"@pt-BR .

ontompo:DeleteOperation a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "DeleteOperation"@en ;
    rdfs:comment "Operação CRUD que faz deixar de existir um registro."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf ontompo:CrudOperation ;
    skos:prefLabel "CRUD Delete Operation"@en,
        "Operação de exclusão"@pt-BR .

ontompo:ObservatoryUser a gufo:Role,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ObservatoryUser"@en ;
    rdfs:comment "Ator humano que desfruta das utilidades que um observatório de projetos proporciona."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf ontompo:Person ;
    skos:prefLabel "Observatory User"@en,
        "Usuário do observatório"@pt-BR .

ontompo:Person a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Person"@en ;
    rdfs:comment "Ser humano que participa de um observatório de projetos, em qualquer papel."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf ontompo:PhysicalAgent ;
    skos:prefLabel "Person"@en,
        "Pessoa"@pt-BR .

ontompo:ReadOperation a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ReadOperation"@en ;
    rdfs:comment "Operação CRUD que consulta um registro sem alterá-lo."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf ontompo:CrudOperation ;
    skos:prefLabel "CRUD Read Operation"@en,
        "Operação de leitura"@pt-BR .

ontompo:StakeHolder a gufo:RoleMixin,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "StakeHolder"@en ;
    rdfs:comment "Indivíduo, grupo ou organização que pode afetar ou ser afetado por uma decisão, atividade ou resultado de um projeto observado."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf ontompo:Agent ;
    skos:prefLabel "Stakeholder"@en,
        "Parte interessada"@pt-BR .

ontompo:System a gufo:Role,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "System"@en ;
    rdfs:comment "Ator não-humano: sistema computacional externo ao ambiente do observatório que executa alguma ação ou fornece algum serviço a ele."@pt-BR ;
    rdfs:isDefinedBy <https://example.org/ontompo/rodada-2> ;
    rdfs:subClassOf ontompo:ComputationalSystem ;
    skos:prefLabel "System"@en,
        "Sistema"@pt-BR .

ontompo:UpdateOperation a gufo:EventType,
