@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://example.org/ontompo/rodada-2> rdf:type owl:Ontology;
    owl:imports gufo:.
ontompo:Agent rdf:type owl:Class, gufo:Category, owl:NamedIndividual;
    rdfs:subClassOf gufo:Object;
    rdfs:label "Agent"@en.
