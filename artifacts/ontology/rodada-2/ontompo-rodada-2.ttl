    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "DataSource"@en.
ontompo:ProjectObservatory rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "ProjectObservatory"@en.
ontompo:Software rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
