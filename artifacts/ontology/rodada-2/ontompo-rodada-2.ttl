ontompo:Processor rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty ontompo:participation_Processor_Transform;
  owl:someValuesFrom ontompo:Transform
].
ontompo:Load rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf ontompo:participation_Processor_Load ];
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass ontompo:Processor
].
ontompo:Processor rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty ontompo:participation_Processor_Load;
  owl:someValuesFrom ontompo:Load
].
ontompo:Load rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf ontompo:participation_Storer_Load ];
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass ontompo:Storer
].
ontompo:Storer rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty ontompo:participation_Storer_Load;
  owl:someValuesFrom ontompo:Load
].
ontompo:EtlProcess rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf ontompo:participational_Extract_EtlProcess ];
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass ontompo:Extract
].
ontompo:Extract rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty ontompo:participational_Extract_EtlProcess;
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass ontompo:EtlProcess
].
ontompo:EtlProcess rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf ontompo:participational_Transform_EtlProcess ];
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass ontompo:Transform
].
ontompo:Transform rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty ontompo:participational_Transform_EtlProcess;
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass ontompo:EtlProcess
].
ontompo:EtlProcess rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf ontompo:participational_Load_EtlProcess ];
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass ontompo:Load
].
ontompo:Load rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty ontompo:participational_Load_EtlProcess;
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass ontompo:EtlProcess
].
ontompo:Observation rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf ontompo:creation_Knowledge_Observation ];
  owl:someValuesFrom ontompo:Knowledge
].
ontompo:Knowledge rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty ontompo:creation_Knowledge_Observation;
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass ontompo:Observation
].
