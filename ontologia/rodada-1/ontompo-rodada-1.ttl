    rdfs:label "SoftwareExecution"@en.
ontompo:ServiceProvision rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Relator;
    rdfs:label "ServiceProvision"@en.
ontompo:Connection rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
