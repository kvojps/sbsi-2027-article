    rdfs:domain ontompo:Observation;
    rdfs:range ontompo:Disseminator;
    rdfs:label "mediation_Observation_Disseminator"@en;
    rdfs:subPropertyOf gufo:mediates.
ontompo:mediation_SocialInteraction_Agent rdf:type owl:ObjectProperty;
