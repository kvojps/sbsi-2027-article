  owl:onProperty ontompo:mediation_Extract_DataSource;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass ontompo:DataSource
].
ontompo:Collector rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf ontompo:mediation_Transform_Collector ];
  owl:someValuesFrom ontompo:Transform
].
ontompo:Transform rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty ontompo:mediation_Transform_Collector;
