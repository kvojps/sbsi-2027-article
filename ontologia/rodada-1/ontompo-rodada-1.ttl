    rdfs:label "CrudOperation"@en.
ontompo:CreateOperation rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "CreateOperation"@en.
ontompo:ReadOperation rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "ReadOperation"@en.
ontompo:UpdateOperation rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "UpdateOperation"@en.
ontompo:DeleteOperation rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "DeleteOperation"@en.
ontompo:CrudRepository rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "CrudRepository"@en.
ontompo:Project rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Project"@en.
ontompo:Disseminator rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Disseminator"@en.
ontompo:Reporter rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Reporter"@en.
ontompo:CrudView rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "CrudView"@en.
ontompo:DataManager rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "DataManager"@en.
ontompo:View rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "View"@en.
ontompo:ProjectDataManagement rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Relator;
    rdfs:label "ProjectDataManagement"@en.
ontompo:ViewProvision rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Relator;
    rdfs:label "ViewProvision"@en.
ontompo:Collector rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Collector"@en.
ontompo:Processor rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Processor"@en.
ontompo:Storer rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "Storer"@en.
ontompo:Extract rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Relator;
    rdfs:label "Extract"@en.
ontompo:Transform rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Relator;
    rdfs:label "Transform"@en.
ontompo:Load rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Relator;
    rdfs:label "Load"@en.
ontompo:DataSource rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "DataSource"@en.
ontompo:ProjectObservatory rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "ProjectObservatory"@en.
ontompo:Software rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Software"@en.
ontompo:Service rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
