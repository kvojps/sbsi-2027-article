  owl:onClass ontompo:CrudView
].
ontompo:ProjectDataManagement rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty ontompo:mediation_ProjectDataManagement_DataManager;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
