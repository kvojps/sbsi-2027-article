ontompo:mediation_ProjectDataManagement_Project rdf:type owl:ObjectProperty;
    rdfs:domain ontompo:ProjectDataManagement;
    rdfs:range ontompo:Project;
    rdfs:label "mediation_ProjectDataManagement_Project"@en;
    rdfs:subPropertyOf gufo:mediates.
ontompo:mediation_ViewProvision_DataManager rdf:type owl:ObjectProperty;
    rdfs:domain ontompo:ViewProvision;
    rdfs:range ontompo:DataManager;
    rdfs:label "mediation_ViewProvision_DataManager"@en;
