    rdfs:label "Connection"@en.
ontompo:Network rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Network"@en.
ontompo:ObservatoryUser rdfs:subClassOf ontompo:Agent.
ontompo:StakeHolder rdfs:subClassOf ontompo:Agent.
ontompo:System rdfs:subClassOf ontompo:Agent.
ontompo:CreateOperation rdfs:subClassOf ontompo:CrudOperation.
ontompo:ReadOperation rdfs:subClassOf ontompo:CrudOperation.
ontompo:UpdateOperation rdfs:subClassOf ontompo:CrudOperation.
ontompo:DeleteOperation rdfs:subClassOf ontompo:CrudOperation.
ontompo:CrudRepository rdfs:subClassOf ontompo:DataManager.
ontompo:Collector rdfs:subClassOf ontompo:DataManager.
ontompo:Processor rdfs:subClassOf ontompo:DataManager.
ontompo:Storer rdfs:subClassOf ontompo:DataManager.
ontompo:Disseminator rdfs:subClassOf ontompo:View.
ontompo:Reporter rdfs:subClassOf ontompo:View.
ontompo:CrudView rdfs:subClassOf ontompo:View.
ontompo:DataManager rdfs:subClassOf ontompo:Software.
ontompo:View rdfs:subClassOf ontompo:Software.
ontompo:ProjectObservatory rdfs:subClassOf ontompo:Software.
[ rdf:type owl:AllDisjointClasses ] owl:members (ontompo:CreateOperation ontompo:ReadOperation ontompo:UpdateOperation ontompo:DeleteOperation).
ontompo:CrudOperation owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (ontompo:CreateOperation ontompo:ReadOperation ontompo:UpdateOperation ontompo:DeleteOperation)
].
ontompo:memberOf_ObservatoryUser_ObservatoryGroup rdf:type owl:ObjectProperty;
    rdfs:domain ontompo:ObservatoryUser;
    rdfs:range ontompo:ObservatoryGroup;
    rdfs:label "memberOf_ObservatoryUser_ObservatoryGroup"@en;
    rdfs:subPropertyOf gufo:isCollectionMemberOf.
ontompo:memberOf_StakeHolder_ObservatoryGroup rdf:type owl:ObjectProperty;
    rdfs:domain ontompo:StakeHolder;
    rdfs:range ontompo:ObservatoryGroup;
    rdfs:label "memberOf_StakeHolder_ObservatoryGroup"@en;
    rdfs:subPropertyOf gufo:isCollectionMemberOf.
ontompo:memberOf_System_ObservatoryGroup rdf:type owl:ObjectProperty;
    rdfs:domain ontompo:System;
    rdfs:range ontompo:ObservatoryGroup;
    rdfs:label "memberOf_System_ObservatoryGroup"@en;
    rdfs:subPropertyOf gufo:isCollectionMemberOf.
ontompo:componentOf_DataManager_ProjectObservatory rdf:type owl:ObjectProperty;
    rdfs:domain ontompo:DataManager;
    rdfs:range ontompo:ProjectObservatory;
    rdfs:label "componentOf_DataManager_ProjectObservatory"@en;
    rdfs:subPropertyOf gufo:isComponentOf.
ontompo:componentOf_View_ProjectObservatory rdf:type owl:ObjectProperty;
